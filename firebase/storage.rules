rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function me() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return request.auth != null && me().role == 'admin'; }
    function memberOf(agencyId) {
      return request.auth != null && me().role == 'agency' && me().agencyId == agencyId;
    }

    // users/{uid}/avatar.jpg
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if (request.auth != null && request.auth.uid == userId
                       && request.resource.size < 5 * 1024 * 1024
                       && request.resource.contentType.matches('image/.*'))
                   || isAdmin();
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // agencies/{agencyId}/logo, personnel photos, documents (images or PDF, 10 MB)
    match /agencies/{agencyId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if (memberOf(agencyId)
                       && request.resource.size < 10 * 1024 * 1024
                       && (request.resource.contentType.matches('image/.*')
                           || request.resource.contentType == 'application/pdf'))
                   || isAdmin();
      allow delete: if memberOf(agencyId) || isAdmin();
    }
  }
}
