rules_version = '2';

// Haven — Firestore security rules
// Roles live in users/{uid}.role : 'customer' | 'bouncer' | 'admin'
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(uid())).data; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && userDoc().role == 'admin';
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function reviewPath(reviewId) {
      return /databases/$(database)/documents/reviews/$(reviewId);
    }
    function bookingPath(bookingId) {
      return /databases/$(database)/documents/bookings/$(bookingId);
    }
    function bouncerPath(bouncerId) {
      return /databases/$(database)/documents/bouncers/$(bouncerId);
    }
    function validReviewRatingUpdate(bouncerId, reviewId) {
      let review = getAfter(reviewPath(reviewId)).data;
      let booking = get(bookingPath(reviewId)).data;
      let bookingAfter = getAfter(bookingPath(reviewId)).data;
      return existsAfter(reviewPath(reviewId))
        && !exists(reviewPath(reviewId))
        && exists(bookingPath(reviewId))
        && review.bookingId == reviewId
        && review.customerId == uid()
        && review.bouncerId == bouncerId
        && review.rating is int
        && review.rating >= 1 && review.rating <= 5
        && booking.customerId == uid()
        && booking.bouncerId == bouncerId
        && booking.status == 'completed'
        && booking.reviewed == false
        && bookingAfter.reviewed == true;
    }
    function bouncerRatingIncludesReview(bouncerId, reviewId, rating) {
      let before = get(bouncerPath(bouncerId)).data;
      let after = getAfter(bouncerPath(bouncerId)).data;
      return exists(bouncerPath(bouncerId))
        && after.lastReviewId == reviewId
        && after.reviewCount == before.reviewCount + 1
        && after.ratingTotal == before.ratingTotal + rating
        && after.rating == after.ratingTotal / after.reviewCount;
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      // Self sign-up: may only pick customer or bouncer, never admin.
      allow create: if signedIn() && uid() == userId
        && request.resource.data.role in ['customer', 'bouncer']
        && request.resource.data.isActive == true;
      // Self edit: cannot change own role or active flag.
      allow update: if isAdmin()
        || (signedIn() && uid() == userId
            && !changed().hasAny(['role', 'isActive', 'createdAt']));
      allow delete: if isAdmin();
    }

    // ---------- bouncers (public profiles) ----------
    match /bouncers/{bouncerId} {
      allow read: if signedIn()
        && (resource.data.status == 'approved' || uid() == bouncerId || isAdmin());

      allow create: if signedIn() && uid() == bouncerId
        && request.resource.data.status == 'pending'
        && request.resource.data.verified == false
        && request.resource.data.rating == 0
        && request.resource.data.reviewCount == 0
        && request.resource.data.ratingTotal == 0
        && request.resource.data.lastReviewId == null;
      allow update: if isAdmin()
        // Bouncer edits own profile but not moderation / rating fields.
        || (signedIn() && uid() == bouncerId
            && !changed().hasAny(['status', 'verified', 'rating', 'reviewCount', 'ratingTotal', 'lastReviewId', 'createdAt']))
        // A rating increment must be atomic with its completed-booking review.
        || (signedIn() && uid() != bouncerId
            && request.resource.data.lastReviewId is string
            && changed().hasOnly(['rating', 'reviewCount', 'ratingTotal', 'lastReviewId'])
            && request.resource.data.reviewCount == resource.data.reviewCount + 1
            && validReviewRatingUpdate(bouncerId, request.resource.data.lastReviewId)
            && request.resource.data.ratingTotal == resource.data.ratingTotal
                + getAfter(reviewPath(request.resource.data.lastReviewId)).data.rating
            && request.resource.data.rating
                == request.resource.data.ratingTotal / request.resource.data.reviewCount);

      allow delete: if isAdmin();
    }

    // ---------- bookings ----------
    match /bookings/{bookingId} {
      function party() {
        return signedIn() && (resource.data.customerId == uid() || resource.data.bouncerId == uid());
      }

      allow read: if party() || isAdmin();

      allow create: if signedIn()
        && request.resource.data.customerId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewed == false;

      allow update: if isAdmin()
        // Customer: cancel a pending/accepted booking, or mark it reviewed.
        || (signedIn() && resource.data.customerId == uid()
            && changed().hasOnly(['status', 'updatedAt', 'reviewed'])
            && ((request.resource.data.status == 'cancelled'
                 && resource.data.status in ['pending', 'accepted'])
                || (request.resource.data.status == resource.data.status
                    && request.resource.data.reviewed == true
                    && resource.data.status == 'completed')))
        // Bouncer: accept/decline pending, complete accepted.
        || (signedIn() && resource.data.bouncerId == uid()
            && changed().hasOnly(['status', 'updatedAt', 'bouncerNote'])
            && ((resource.data.status == 'pending'
                 && request.resource.data.status in ['accepted', 'declined'])
                || (resource.data.status == 'accepted'
                    && request.resource.data.status in ['completed', 'accepted'])));

      allow delete: if isAdmin();
    }

    // ---------- reviews (doc id == bookingId, so one review per booking) ----------
    match /reviews/{bookingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.bookingId == bookingId
        && request.resource.data.customerId == uid()
        && request.resource.data.bouncerId != uid()
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && get(bookingPath(bookingId)).data.customerId == uid()
        && get(bookingPath(bookingId)).data.status == 'completed'
        && get(bookingPath(bookingId)).data.reviewed == false
        && get(bookingPath(bookingId)).data.bouncerId == request.resource.data.bouncerId
        && getAfter(bookingPath(bookingId)).data.reviewed == true
        && bouncerRatingIncludesReview(
          request.resource.data.bouncerId, bookingId, request.resource.data.rating);
      allow update, delete: if isAdmin();
    }

    // ---------- app settings (admin-managed, readable by all signed-in) ----------
    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
